{
  "name": "server-bun",
  "version": "1.0.0",
  "description": "Express server with Bun equivalent to Python FastAPI server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/langgraph-sdk": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "e2b": "^2.8.1",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "bun-types": "latest",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0"
  }
}